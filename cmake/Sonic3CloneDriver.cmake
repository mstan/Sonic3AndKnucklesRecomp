set(S3_CLONE_DRIVER_SUPPORT "AUTO" CACHE STRING "Compile optional driver software: AUTO, ON, OFF")
set_property(CACHE S3_CLONE_DRIVER_SUPPORT PROPERTY STRINGS AUTO ON OFF)
set(S3_CLONE_PROGRAM_DIR "" CACHE PATH "Prebuilt software-only Clone Driver")
if(NOT S3_CLONE_DRIVER_SUPPORT MATCHES "^(AUTO|ON|OFF)$")
    message(FATAL_ERROR "Invalid S3_CLONE_DRIVER_SUPPORT")
endif()
find_package(Python3 COMPONENTS Interpreter REQUIRED)
set(_clone_tools "${CMAKE_SOURCE_DIR}/tools/clone_driver")
file(GLOB _clone_inputs CONFIGURE_DEPENDS "${_clone_tools}/*.py" "${_clone_tools}/*.asm" "${_clone_tools}/*.json")
set(_clone_key "")
foreach(_file IN LISTS _clone_inputs)
    file(SHA256 "${_file}" _hash)
    string(APPEND _clone_key "${_hash}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
endforeach()
string(SHA256 _clone_key "${_clone_key}")
if(S3_CLONE_DRIVER_SUPPORT STREQUAL "OFF")
    set(S3_CLONE_PROGRAM_DIR "")
elseif(NOT S3_CLONE_PROGRAM_DIR)
    set(_clone_out "${CMAKE_BINARY_DIR}/clone-software/${_clone_key}")
    if(NOT EXISTS "${_clone_out}/program.json")
        execute_process(COMMAND "${Python3_EXECUTABLE}" -B "${_clone_tools}/build.py"
            --cache "${CMAKE_BINARY_DIR}/clone-cache" --output "${_clone_out}"
            RESULT_VARIABLE _clone_rc)
        if(NOT _clone_rc EQUAL 0)
            if(S3_CLONE_DRIVER_SUPPORT STREQUAL "ON")
                message(FATAL_ERROR "Unable to build pinned Clone Driver software")
            endif()
            message(WARNING "Clone Driver unavailable; configure ON to require it")
        endif()
    endif()
    if(EXISTS "${_clone_out}/program.json")
        set(S3_CLONE_PROGRAM_DIR "${_clone_out}")
    endif()
endif()
